# Copia este archivo a .env (ignorado por Git). En Vercel, Neon inyecta DATABASE_URL y
# DATABASE_URL_UNPOOLED automáticamente.
# En local, docker-compose expone Postgres en el puerto 5433.

# Conexión de la app (en Neon: la URL con pooling)
DATABASE_URL="postgresql://horario:horario@localhost:5433/horario?schema=public"
# Conexión para migraciones de Prisma (en Neon: la URL sin pooling)
DATABASE_URL_UNPOOLED="postgresql://horario:horario@localhost:5433/horario?schema=public"
# Base desechable para los tests e2e
DATABASE_URL_TEST="postgresql://horario:horario@localhost:5433/horario_test?schema=public"

# Secreto para firmar JWT (en producción: aleatorio, 32+ caracteres)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Orígenes permitidos (lista separada por comas; admite * en el subdominio)
CORS_ORIGIN="http://localhost:5173"
